{
  "$description": "trackxai caption theme, dark. Colours from the Kalebtec brand tokens: brand.light violet on ink.soft.",
  "color": {
    "accent": { "$type": "color", "$value": "#a64dff" },
    "ink": { "$type": "color", "$value": "#f1f0e4" },
    "callout": {
      "background": { "$type": "color", "$value": "#151b20" },
      "border": { "$type": "color", "$value": "#a64dff" }
    },
    "badge": { "background": { "$type": "color", "$value": "#8000ff" } }
  },
  "border": { "callout": { "width": { "$type": "dimension", "$value": "1px" } } },
  "radius": { "callout": { "$type": "dimension", "$value": "8px" } },
  "shadow": { "callout": { "$value": "0px 4px 14px 0px rgba(0,0,0,0.45)" } },
  "shape": {
    "badge": { "$value": "circle" },
    "connector": { "$value": "line" }
  },
  "font": {
    "size": { "caption": { "$type": "dimension", "$value": "14px" } },
    "line-height": { "caption": { "$type": "dimension", "$value": "20px" } }
  },
  "space": {
    "callout": {
      "x": { "$type": "dimension", "$value": "12px" },
      "y": { "$type": "dimension", "$value": "8px" }
    }
  }
}
