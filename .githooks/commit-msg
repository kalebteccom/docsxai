#!/usr/bin/env bash
# Commit-msg hook: enforces the docsxai commit-message contract repo-wide,
# not just inside Claude Code. Mirrors the policy implemented in
# .claude/hooks/block-{long-commits,ai-attribution}.sh so anyone (human,
# Codex, Cursor, agent-of-the-week) hitting `git commit` from inside the
# tree gets the same gate.
#
# Rules:
#   1. Subject line ≤ 72 chars.
#   2. Conventional-commits prefix
#      (feat|fix|chore|docs|refactor|test|perf|build|ci|style|revert)(scope)?: ...
#   3. No body beyond a trailer block, separated from the subject by one
#      blank line. No prose, no bullet points.
#   4. Allowed trailers: Signed-off-by (DCO, `git commit -s`, any number) and,
#      for AI-assisted commits, exactly one
#        Co-Authored-By: <Claude model name> <noreply@anthropic.com>
#      Commits without AI help need no Co-Authored-By; it is never required.
#      Any other Co-Authored-By, or a "Generated with" line, is rejected.
#
# Bypass (emergency only): git commit --no-verify

set -euo pipefail

MAX_SUBJECT=72
MSG_FILE="${1:-}"
if [[ -z "$MSG_FILE" || ! -f "$MSG_FILE" ]]; then
  exit 0
fi

AI_TRAILER_RE='^Co-Authored-By: Claude( [A-Za-z0-9.()+-]+)* <noreply@anthropic\.com>$'
SIGNOFF_RE='^Signed-off-by: .+ <[^<>[:space:]]+@[^<>[:space:]]+>$'

# Strip comment lines (git adds them automatically).
MSG_BODY=$(grep -v '^#' "$MSG_FILE" || true)
# Trim trailing blank lines.
MSG_BODY=$(printf '%s' "$MSG_BODY" | awk 'NF { last = NR } { lines[NR] = $0 } END { for (i = 1; i <= last; i++) print lines[i] }')

if [[ -z "$MSG_BODY" ]]; then
  exit 0
fi

SUBJECT=$(printf '%s\n' "$MSG_BODY" | head -n 1)
SECOND_LINE=$(printf '%s\n' "$MSG_BODY" | sed -n '2p')

ERRORS=()

if (( ${#SUBJECT} > MAX_SUBJECT )); then
  ERRORS+=("Subject line is ${#SUBJECT} chars (max ${MAX_SUBJECT}).")
fi

if ! printf '%s' "$SUBJECT" | grep -qE '^(feat|fix|chore|docs|refactor|test|perf|build|ci|style|revert)(\([a-z0-9._/-]+\))?!?: .+'; then
  ERRORS+=("Subject does not match conventional-commits prefix (feat|fix|chore|docs|refactor|test|perf|build|ci|style|revert)[(scope)]: subject.")
fi

# Body: only trailers, after one blank line.
AI_COUNT=0
OTHER_COUNT=0
while IFS= read -r line; do
  [[ -z "${line//[[:space:]]/}" ]] && continue
  if printf '%s\n' "$line" | grep -qiE "$AI_TRAILER_RE"; then
    AI_COUNT=$((AI_COUNT + 1))
  elif printf '%s\n' "$line" | grep -qiE "$SIGNOFF_RE"; then
    :
  else
    OTHER_COUNT=$((OTHER_COUNT + 1))
  fi
done < <(printf '%s\n' "$MSG_BODY" | tail -n +2)

if (( OTHER_COUNT > 0 )); then
  ERRORS+=("Message body has ${OTHER_COUNT} line(s) that are not an allowed trailer. Allowed: 'Signed-off-by: Name <email>' and one 'Co-Authored-By: <Claude model name> <noreply@anthropic.com>'. No prose, bullets, or other credit lines.")
elif [[ -n "$(printf '%s\n' "$MSG_BODY" | tail -n +2 | tr -d '[:space:]')" && -n "${SECOND_LINE//[[:space:]]/}" ]]; then
  ERRORS+=("Separate the trailer from the subject with a blank line.")
fi

if (( AI_COUNT > 1 )); then
  ERRORS+=("Found ${AI_COUNT} Co-Authored-By trailers; use exactly one.")
fi

if (( ${#ERRORS[@]} > 0 )); then
  echo "Commit message rejected:" >&2
  for err in "${ERRORS[@]}"; do
    echo "  - $err" >&2
  done
  echo "" >&2
  echo "Bypass (emergency only): git commit --no-verify" >&2
  exit 1
fi

exit 0
