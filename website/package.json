{
  "name": "@docsxai/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The docsxai documentation site (docsxai.dev). Astro + Starlight.",
  "scripts": {
    "dev": "node scripts/sync-docs.mjs && astro dev",
    "start": "node scripts/sync-docs.mjs && astro dev",
    "build": "node scripts/sync-docs.mjs && node ../scripts/prose-guard.mjs && astro build && node scripts/check-agent-surface.mjs && node scripts/check-a11y-surface.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "node --test scripts/check-scrollbars.test.mjs scripts/transcripts.test.mjs ../scripts/landing-showcase-plan.test.mjs",
    "og": "node scripts/gen-og.mjs"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/starlight": "0.42.6",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "astro": "7.4.1",
    "sharp": "^0.35.4",
    "starlight-links-validator": "^0.27.0"
  }
}
