{
  "defaults": {
    "obstacleLimit": 40,
    "obstacleRadius": 320,
    "viewportPresets": {
      "desktop": {
        "height": 900,
        "width": 1440
      },
      "mobile": {
        "height": 844,
        "width": 390
      },
      "tablet": {
        "height": 1112,
        "width": 834
      }
    },
    "maxMatrixVariants": 64
  },
  "schemas": {
    "AnnotationsFile": {
      "fields": {
        "annotations": {
          "array": {
            "fields": {
              "arrow_style?": "enum:top-left|top-right|bottom-left|bottom-right|top|bottom|left|right",
              "bounding_box?": {
                "fields": {
                  "height": "number[finite,min:0]",
                  "width": "number[finite,min:0]",
                  "x": "number[finite]",
                  "y": "number[finite]"
                },
                "strict": true
              },
              "copy": "string[min:1]",
              "index?": "number[int,min>0]",
              "nudge?": {
                "fields": {
                  "x": "number",
                  "y": "number"
                },
                "strict": true
              },
              "obstacles?": {
                "array": {
                  "fields": {
                    "height": "number[finite,min:0]",
                    "width": "number[finite,min:0]",
                    "x": "number[finite]",
                    "y": "number[finite]"
                  },
                  "strict": true
                },
                "max": 40
              },
              "placement?": {
                "fields": {
                  "align?": "enum:start|center|end",
                  "inside?": "boolean",
                  "max_width?": "number[finite,max:560,min:120]",
                  "obstacle_limit?": "number[int,max:40,min:1]",
                  "obstacle_radius?": "number[finite,max:2000,min:0]",
                  "pin_arrow?": "boolean",
                  "side?": "enum:top|bottom|left|right"
                },
                "strict": true
              },
              "selector": "string[min:1]",
              "step": "string[min:1]"
            },
            "strict": true
          }
        },
        "flow": "string[min:1]",
        "schema": "literal:docsxai/annotations@1",
        "variant?": {
          "strict": true,
          "fields": {
            "color_scheme?": "enum:light|dark",
            "id": "string[min:1]",
            "locale?": "string[regex:^[A-Za-z]{2,3}(-[A-Za-z0-9]+)*$]",
            "viewport?": {
              "strict": true,
              "fields": {
                "height": "number[int,min>0]",
                "name": "string[min:1]",
                "width": "number[int,min>0]"
              }
            }
          }
        }
      },
      "strict": true
    },
    "AuthStrategyDescriptor": {
      "fields": {
        "default_role": "string[min:1]",
        "roles": {
          "record": {
            "fields": {
              "cache?": {
                "default": {
                  "enabled": false,
                  "store": "local",
                  "ttl": "session"
                },
                "of": {
                  "fields": {
                    "auth_cookie?": "string[min:1]",
                    "enabled?": {
                      "default": false,
                      "of": "boolean"
                    },
                    "store?": {
                      "default": "local",
                      "of": "enum:local|backend"
                    },
                    "ttl?": {
                      "default": "session",
                      "of": {
                        "oneOf": [
                          "literal:session",
                          "string[regex:^\\d+(ms|s|m|h)$]",
                          "number[int,min>0]"
                        ]
                      }
                    }
                  },
                  "strict": true
                }
              },
              "creds_env?": {
                "default": {},
                "of": {
                  "record": "string"
                }
              },
              "options?": {
                "default": {},
                "of": {
                  "record": "unknown"
                }
              },
              "strategy": "enum:api-login|jwt-injection|ui-form|http-basic|mtls|pat-header|email-otp|totp|webauthn|manual-capture|test-backdoor"
            },
            "strict": true
          }
        },
        "schema": "literal:docsxai/auth-strategy@1"
      },
      "strict": true
    },
    "FlowFile": {
      "fields": {
        "environment?": {
          "fields": {
            "clock?": "string[datetime]",
            "color_scheme?": "enum:light|dark",
            "locale?": "string[regex:^[A-Za-z]{2,3}(-[A-Za-z0-9]+)*$]",
            "reduced_motion?": "boolean",
            "timezone?": "string[min:1]",
            "viewport?": {
              "oneOf": [
                "enum:desktop|tablet|mobile",
                {
                  "fields": {
                    "height": "number[int,min>0]",
                    "width": "number[int,min>0]"
                  },
                  "strict": true
                }
              ]
            }
          },
          "strict": true
        },
        "extends?": "string[max:64,min:1,regex:^[A-Za-z0-9][A-Za-z0-9._-]*$]",
        "locators?": {
          "default": {},
          "of": {
            "record": "string"
          }
        },
        "name": "string[max:64,min:1,regex:^[A-Za-z0-9][A-Za-z0-9._-]*$]",
        "prerequisites?": {
          "default": [],
          "of": {
            "array": {
              "record": {
                "oneOf": ["string", "boolean"]
              }
            }
          }
        },
        "redactions?": {
          "array": {
            "oneOf": [
              {
                "fields": {
                  "selector": "string[min:1]",
                  "style?": "enum:box|pixelate"
                },
                "strict": true
              },
              {
                "fields": {
                  "region": {
                    "fields": {
                      "height": "number[min>0]",
                      "width": "number[min>0]",
                      "x": "number[min:0]",
                      "y": "number[min:0]"
                    },
                    "strict": true
                  },
                  "style?": "enum:box|pixelate"
                },
                "strict": true
              }
            ]
          },
          "min": 1
        },
        "steps": {
          "array": {
            "fields": {
              "action": "enum:navigate|click|fill|upload|press|hover|select|check|uncheck|wait|hide|show",
              "annotation?": {
                "fields": {
                  "arrow?": "enum:top-left|top-right|bottom-left|bottom-right|top|bottom|left|right",
                  "copy": "string[min:1]",
                  "nudge?": {
                    "fields": {
                      "x": "number",
                      "y": "number"
                    },
                    "strict": true
                  },
                  "placement?": {
                    "fields": {
                      "align?": "enum:start|center|end",
                      "inside?": "boolean",
                      "max_width?": "number[finite,max:560,min:120]",
                      "obstacle_limit?": "number[int,max:40,min:1]",
                      "obstacle_radius?": "number[finite,max:2000,min:0]",
                      "pin_arrow?": "boolean",
                      "side?": "enum:top|bottom|left|right"
                    },
                    "strict": true
                  },
                  "target?": "string[min:1]",
                  "copy_by_locale?": {
                    "record": "string[min:1]"
                  },
                  "only?": {
                    "strict": true,
                    "fields": {
                      "color_scheme?": {
                        "array": "enum:light|dark",
                        "min": 1
                      },
                      "locale?": {
                        "array": "string[regex:^[A-Za-z]{2,3}(-[A-Za-z0-9]+)*$]",
                        "min": 1
                      },
                      "viewport?": {
                        "array": "string[regex:^[a-z0-9][a-z0-9-]*$]",
                        "min": 1
                      }
                    }
                  },
                  "skip?": {
                    "strict": true,
                    "fields": {
                      "color_scheme?": {
                        "array": "enum:light|dark",
                        "min": 1
                      },
                      "locale?": {
                        "array": "string[regex:^[A-Za-z]{2,3}(-[A-Za-z0-9]+)*$]",
                        "min": 1
                      },
                      "viewport?": {
                        "array": "string[regex:^[a-z0-9][a-z0-9-]*$]",
                        "min": 1
                      }
                    }
                  }
                },
                "strict": true
              },
              "annotations?": {
                "array": {
                  "fields": {
                    "arrow?": "enum:top-left|top-right|bottom-left|bottom-right|top|bottom|left|right",
                    "copy": "string[min:1]",
                    "nudge?": {
                      "fields": {
                        "x": "number",
                        "y": "number"
                      },
                      "strict": true
                    },
                    "placement?": {
                      "fields": {
                        "align?": "enum:start|center|end",
                        "inside?": "boolean",
                        "max_width?": "number[finite,max:560,min:120]",
                        "obstacle_limit?": "number[int,max:40,min:1]",
                        "obstacle_radius?": "number[finite,max:2000,min:0]",
                        "pin_arrow?": "boolean",
                        "side?": "enum:top|bottom|left|right"
                      },
                      "strict": true
                    },
                    "target?": "string[min:1]",
                    "copy_by_locale?": {
                      "record": "string[min:1]"
                    },
                    "only?": {
                      "strict": true,
                      "fields": {
                        "color_scheme?": {
                          "array": "enum:light|dark",
                          "min": 1
                        },
                        "locale?": {
                          "array": "string[regex:^[A-Za-z]{2,3}(-[A-Za-z0-9]+)*$]",
                          "min": 1
                        },
                        "viewport?": {
                          "array": "string[regex:^[a-z0-9][a-z0-9-]*$]",
                          "min": 1
                        }
                      }
                    },
                    "skip?": {
                      "strict": true,
                      "fields": {
                        "color_scheme?": {
                          "array": "enum:light|dark",
                          "min": 1
                        },
                        "locale?": {
                          "array": "string[regex:^[A-Za-z]{2,3}(-[A-Za-z0-9]+)*$]",
                          "min": 1
                        },
                        "viewport?": {
                          "array": "string[regex:^[a-z0-9][a-z0-9-]*$]",
                          "min": 1
                        }
                      }
                    }
                  },
                  "strict": true
                },
                "min": 1
              },
              "id": "string[min:1]",
              "optional?": "boolean",
              "redactions?": {
                "array": {
                  "oneOf": [
                    {
                      "fields": {
                        "selector": "string[min:1]",
                        "style?": "enum:box|pixelate"
                      },
                      "strict": true
                    },
                    {
                      "fields": {
                        "region": {
                          "fields": {
                            "height": "number[min>0]",
                            "width": "number[min>0]",
                            "x": "number[min:0]",
                            "y": "number[min:0]"
                          },
                          "strict": true
                        },
                        "style?": "enum:box|pixelate"
                      },
                      "strict": true
                    }
                  ]
                },
                "min": 1
              },
              "success?": {
                "oneOf": [
                  {
                    "fields": {
                      "visible": "string[min:1]"
                    },
                    "strict": true
                  },
                  {
                    "fields": {
                      "hidden": "string[min:1]"
                    },
                    "strict": true
                  },
                  {
                    "fields": {
                      "url_matches": "string[min:1]"
                    },
                    "strict": true
                  },
                  {
                    "fields": {
                      "text_contains": {
                        "fields": {
                          "selector": "string[min:1]",
                          "text": "string"
                        },
                        "strict": true
                      }
                    },
                    "strict": true
                  }
                ]
              },
              "target?": "string[min:1]",
              "timeout_ms?": "number[int,max:30000,min:100]",
              "value?": "string",
              "wait_for?": {
                "oneOf": [
                  "enum:network_idle|element_stable|load|settled",
                  {
                    "fields": {
                      "timeout_ms": "number[int,min>0]"
                    },
                    "strict": true
                  },
                  {
                    "fields": {
                      "selector": "string[min:1]",
                      "timeout_ms?": "number[int,min>0]"
                    },
                    "strict": true
                  }
                ]
              },
              "only?": {
                "strict": true,
                "fields": {
                  "color_scheme?": {
                    "array": "enum:light|dark",
                    "min": 1
                  },
                  "locale?": {
                    "array": "string[regex:^[A-Za-z]{2,3}(-[A-Za-z0-9]+)*$]",
                    "min": 1
                  },
                  "viewport?": {
                    "array": "string[regex:^[a-z0-9][a-z0-9-]*$]",
                    "min": 1
                  }
                }
              },
              "skip?": {
                "strict": true,
                "fields": {
                  "color_scheme?": {
                    "array": "enum:light|dark",
                    "min": 1
                  },
                  "locale?": {
                    "array": "string[regex:^[A-Za-z]{2,3}(-[A-Za-z0-9]+)*$]",
                    "min": 1
                  },
                  "viewport?": {
                    "array": "string[regex:^[a-z0-9][a-z0-9-]*$]",
                    "min": 1
                  }
                }
              }
            },
            "strict": true
          },
          "min": 1
        },
        "matrix?": {
          "strict": true,
          "fields": {
            "color_schemes?": {
              "array": "enum:light|dark",
              "min": 1,
              "max": 64
            },
            "locales?": {
              "array": "string[regex:^[A-Za-z]{2,3}(-[A-Za-z0-9]+)*$]",
              "min": 1,
              "max": 64
            },
            "viewports?": {
              "array": {
                "oneOf": [
                  "enum:desktop|tablet|mobile",
                  {
                    "strict": true,
                    "fields": {
                      "height": "number[int,min>0]",
                      "name?": "string[regex:^[a-z0-9][a-z0-9-]*$]",
                      "width": "number[int,min>0]"
                    }
                  }
                ]
              },
              "min": 1,
              "max": 64
            }
          }
        }
      },
      "strict": true
    },
    "LocatorManifest": {
      "fields": {
        "flows": {
          "record": {
            "record": "string"
          }
        },
        "schema": "literal:docsxai/locators@1"
      },
      "strict": true
    },
    "RevisionMeta": {
      "fields": {
        "author": "string[min:1]",
        "kind": "enum:calibrate|run|edit",
        "parent_rev_id": {
          "nullable": "string[min:1]"
        },
        "rev_id": "string[min:1]",
        "timestamp": "string[min:1]"
      },
      "strict": true
    },
    "StyleArtifact": {
      "fields": {
        "localisation?": {
          "record": "unknown"
        },
        "pruning_rules?": {
          "array": "string"
        },
        "schema": "literal:docsxai/style@1",
        "structure?": {
          "record": "unknown"
        },
        "terminology?": {
          "record": "string"
        },
        "visual?": {
          "record": "unknown"
        },
        "voice?": {
          "record": "unknown"
        }
      },
      "strict": true
    }
  }
}
